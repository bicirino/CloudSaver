GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=

# Supabase Auth e Banco de Dados (PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Opcionais do Supabase
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_REQUIRED=true

# Conexão PostgreSQL direta com o Supabase (opcional - usa H2 in-memory por padrão se não definido)
# Obtenha em: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Exemplo: jdbc:postgresql://db.your-project.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-database-password

# Opcional: limites do prompt da IA
# GROQ_PROMPT_MAX_RECURSOS=50
# GROQ_PROMPT_LIMITE_REQUISICOES=30
# GROQ_PROMPT_JANELA_MINUTOS=60

# Segurança da API (produção: defina chave e exija)
# CLOUDSAVER_API_KEY=
# CLOUDSAVER_REQUIRE_API_KEY=true
# CLOUDSAVER_RATE_LIMIT_POR_CLIENTE=20
# CLOUDSAVER_RATE_LIMIT_JANELA_MINUTOS=60
